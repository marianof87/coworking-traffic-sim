{
  "name": "coworking-traffic-sim",
  "version": "1.0.0",
  "description": "Simulador de tráfico realista para la API de reserva de espacios de coworking (proyectoXP)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "sim": "tsx src/index.ts run",
    "smoke": "tsx src/index.ts smoke",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:e2e": "vitest run --project e2e"
  },
  "keywords": [
    "simulador",
    "carga",
    "traffic-generator",
    "coworking",
    "xp"
  ],
  "license": "ISC",
  "dependencies": {
    "commander": "^13.1.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.0",
    "fast-check": "^4.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.5"
  }
}
