# URL base del backend proyectoXP (sin barra final)
BASE_URL=http://localhost:3000

# Credenciales de un usuario ADMIN (opcional pero recomendado).
# El backend no expone ningún endpoint para crear admins: hay que darlo de
# alta directamente en la base de datos, por ejemplo:
#
#   INSERT INTO users (email, name, password, role, balance, "createdAt", "updatedAt")
#   VALUES ('admin@coworking.com', 'Admin', '<hash bcrypt>', 'ADMIN', 0, NOW(), NOW());
#
# El hash se puede generar con: node -e "console.log(require('bcrypt').hashSync('AdminPass123!', 10))"
#
# Con admin el simulador puede crear salas (si faltan) y avanzar estados de
# reservas (IN_PROGRESS / COMPLETED), lo que hace el tráfico mucho más fiel.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Contraseña que usarán los usuarios virtuales registrados por el simulador
# (debe tener al menos 8 caracteres: es la regla del backend).
SIM_PASSWORD=SimPass123!
